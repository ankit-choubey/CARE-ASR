# Environment Configuration Example for CARE-ASR Module
# Copy this file to .env before running the application

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# BioBERT Model Settings
BIOBERT_MODEL_NAME_OR_PATH=d4data/biomedical-ner-all
TORCH_DEVICE=cuda
BATCH_SIZE=16

# Configuration File Paths
CONFIG_FILE_PATH=config.yaml
LOGGING_CONFIG_PATH=logging.yaml

# Category Threshold Overrides (Optional)
MED_MIN_ASR_CONFIDENCE=0.75
COND_MIN_ASR_CONFIDENCE=0.60
ANA_MIN_ASR_CONFIDENCE=0.65
TTP_MIN_ASR_CONFIDENCE=0.80
PHI_MIN_ASR_CONFIDENCE=0.85
